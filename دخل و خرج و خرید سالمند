.recorder-controls button:disabled{opacity:.45;cursor:not-allowed}
.recorder-status{font-size:13px;line-height:1.8;padding:10px 12px;background:#e8f6ff;border-radius:10px;color:#15517b}
.recordings-list{display:grid;gap:10px;margin-top:12px}
.recording-item{background:#fff;border:1px solid #d9e7ef;border-radius:12px;padding:12px;min-width:0}
.recording-item strong{display:block;overflow-wrap:anywhere;color:#123f65}
.recording-item small{display:block;color:#607b91;line-height:1.8;margin:4px 0}
.recording-item audio{width:100%;height:38px;margin:6px 0}
.recording-actions{display:flex;gap:7px;flex-wrap:wrap}
.recording-actions button{font-size:12px;padding:8px 10px;border-radius:8px}
.recording-download{background:#e1f5eb;color:#087347}.recording-delete{background:#ffe8e6;color:#a62b25}

</style>
</head>
<body>
<div class="app">
<header><div class="brand"><div class="logo">📒🔊</div><div><h1>حسابداری شخصی برای سالمندان</h1><p>ساده • سریع • با مرامِ سخنگو</p></div></div></header>
<main>
<section id="home" class="page active">
  <div class="planner-cover">
    <div class="cover-copy">
      <span class="cover-kicker">سررسید مالی • نسخه شخصی</span>
      <h2 class="cover-title">دفتر دخل‌وخرج<br>من و با مرام</h2>
      <p class="cover-subtitle">یادداشت، خرید و حساب‌وکتاب؛ راحت و خوانا</p>
      <div class="cover-date" id="coverDayDate">امروز • تاریخ فارسی</div>
      <div class="clock-wrap" id="coverClockWrap" data-mode="digital">
        <div class="digital-clock" id="digitalClock">--:--:--</div>
        <div class="analog-clock" id="analogClock" aria-label="ساعت آنالوگ"><span class="clock-number n12">۱۲</span><span class="clock-number n3">۳</span><span class="clock-number n6">۶</span><span class="clock-number n9">۹</span><span class="clock-hand hour" id="hourHand"></span><span class="clock-hand minute" id="minuteHand"></span><span class="clock-hand second" id="secondHand"></span><span class="clock-pivot"></span></div>
        <div class="cover-clock-meta" id="clockCaption">ساعت محلی دستگاه</div>
      </div>
      <div class="cover-controls"><button class="cover-button" onclick="openPage('settings')">⚙ تنظیمات</button><button class="cover-button" onclick="openPage('notes')">✎ دفتر روزانه</button><button class="cover-button" onclick="openPage('shopping')">🛒 خرید روزانه</button></div>
    </div><div class="cover-emblem"><div class="cover-book-icon">📒</div><small>دفتر من، حساب من</small></div>
  </div>
  <div class="balance"><div class="label">💳 موجودی فعلی</div><div class="amount" id="balance">۰</div><div class="currency">تومان</div></div>
  <div class="quick"><button class="tile green" onclick="openPage('addExpense')"><span>▣</span>ثبت هزینه</button><button class="tile blue" onclick="openPage('addIncome')"><span>＋</span>ثبت درآمد</button><button class="tile orange" onclick="openPage('notes')"><span>▤</span>دفتر روزانه</button><button class="tile purple" onclick="openPage('shopping')"><span>🛒</span>خرید روزانه</button></div>
  <div class="voice"><button class="mic" onclick="greetAndSpeak()" aria-label="با مرام صحبت کن">🔊</button><div><b>با مرام، دستیار سخنگو</b><p id="voiceStatus">برای شنیدن راهنما، دکمه بلندگو را بزنید. برای ثبت با صدا، میکروفون شناور پایین صفحه است.</p></div></div>
  <div class="card"><h2>آخرین تراکنش‌ها</h2><div id="recentList" class="muted">هنوز تراکنشی ثبت نشده است.</div><button class="btn secondary" onclick="openPage('transactions')">مشاهده همه تراکنش‌ها</button></div>
</section>
<section id="addExpense" class="page"><div class="card"><h2>ثبت هزینه</h2><div class="field"><label for="expenseTitle">عنوان هزینه</label><input id="expenseTitle" placeholder="مثلاً خرید نان"></div><div class="row"><div class="field"><label for="expenseAmount">مبلغ (تومان)</label><input id="expenseAmount" class="money-input" type="text" inputmode="numeric" autocomplete="off" placeholder="مثلاً ۵۰٬۰۰۰" oninput="formatMoneyField(this)"></div><div class="field"><label for="expenseCategory">دسته‌بندی</label><select id="expenseCategory"><option>خوراک و خرید</option><option>دارو و درمان</option><option>قبوض</option><option>رفت‌وآمد</option><option>خانه</option><option>سایر</option></select></div></div><div class="field"><label for="expenseNote">توضیحات (اختیاری)</label><input id="expenseNote" placeholder="توضیح کوتاه"></div><button class="btn" onclick="saveTx('out')">ثبت هزینه</button><button class="btn secondary" onclick="openPage('home')">بازگشت</button></div></section>
<section id="addIncome" class="page"><div class="card"><h2>ثبت درآمد</h2><div class="field"><label for="incomeTitle">عنوان درآمد</label><input id="incomeTitle" placeholder="مثلاً حقوق بازنشستگی"></div><div class="field"><label for="incomeAmount">مبلغ (تومان)</label><input id="incomeAmount" class="money-input" type="text" inputmode="numeric" autocomplete="off" placeholder="مثلاً ۱٬۰۰۰٬۰۰۰" oninput="formatMoneyField(this)"></div><div class="field"><label for="incomeNote">توضیحات (اختیاری)</label><input id="incomeNote" placeholder="توضیح کوتاه"></div><button class="btn" onclick="saveTx('in')">ثبت درآمد</button><button class="btn secondary" onclick="openPage('home')">بازگشت</button></div></section>
<section id="notes" class="page">
  <div class="card" style="background:#f7faff">
    <div class="note-book">
      <h2 class="notebook-title">دفتر یادداشت روزانه</h2>
      <div class="notebook-date" id="noteDate">روز هفته • تاریخ • ساعت</div>
      <p class="muted" style="margin:0 0 9px">فقط یادداشت کنید؛ مثل «گوشت ۱.۵ کیلو»، «پیاز ۲ کیلو»، «نان بربری ۲۰ عدد».</p>
      <div class="notebook-form note-only">
        <input id="newNote" placeholder="چیزی برای یادداشت بنویسید..." aria-label="متن یادداشت روزانه" autocomplete="off">
        <button class="btn" onclick="addNote(false)">＋ افزودن</button>
      </div>
      <div id="notesList" class="note-list"></div>
      <p class="muted" style="margin:10px 0 0">برای نوشتن با صدا، میکروفون شناور را بزنید. بعد از شنیدن متن، دکمه «افزودن» را بزنید.</p>
    </div>
    <div class="field" style="margin-top:18px"><label for="freeNote">یادداشت آزاد بلند</label><textarea class="free-writing" id="freeNote" placeholder="اینجا هرچه لازم دارید بنویسید؛ مثل یک صفحه دفتر..."></textarea><button class="btn secondary" onclick="saveFreeNote()">ذخیره یادداشت آزاد</button></div>
  </div>

  <div class="card recorder-card" id="voiceRecorderCard">
    <h2>ضبط صوت شناور</h2>
    <p class="muted">در بازار یا جای شلوغ، به‌جای تبدیل فوری صدا به متن، صحبتتان را ضبط کنید. فایل‌ها در همین برنامه نگهداری می‌شوند و هر زمان خواستید می‌توانید پخش یا دانلودشان کنید.</p>
    <div class="field"><label for="recordCategory">این صدا بعداً به کدام بخش اضافه شود؟</label>
      <select id="recordCategory">
        <option value="یادداشت روزانه">یادداشت روزانه</option>
        <option value="درآمد">درآمد</option>
        <option value="هزینه">هزینه</option>
        <option value="خرید روزانه">خرید روزانه</option>
        <option value="یادآور">یادآور</option>
        <option value="سایر">سایر</option>
      </select>
    </div>
    <div class="recorder-controls">
      <button class="btn" id="recordStart" type="button" onclick="startAudioRecording()">● شروع ضبط</button>
      <button class="btn secondary" id="recordStop" type="button" onclick="stopAudioRecording()" disabled>■ پایان و ذخیره</button>
    </div>
    <div id="recordingStatus" class="recorder-status" role="status">آماده ضبط؛ برای شروع، اجازه استفاده از میکروفون را بدهید.</div>
    <div id="recordingsList" class="recordings-list"></div>
    <p class="muted">نکته: برای اطمینان، فایل مهم را با دکمه «دانلود فایل» در گوشی یا رایانه نیز ذخیره کنید. ضبط صدا به اجازه میکروفون نیاز دارد.</p>
  </div>
  <div class="card reminder-card">
    <h2>⏰ یادآورهای من</h2>
    <p class="muted">مثلاً «ساعت ۱۰ صبح قبض آب را پرداخت کنم» یا «چک را به بانک ببرم».</p>
    <div class="reminder-form">
      <div class="field"><label for="reminderTitle">چه چیزی را یادآوری کنم؟</label><input id="reminderTitle" type="text" placeholder="مثلاً پرداخت قبض آب" maxlength="180"></div>
      <div class="reminder-fields">
        <div class="field"><label for="reminderDate">تاریخ</label><input id="reminderDate" type="date"></div>
        <div class="field"><label for="reminderTime">ساعت</label><input id="reminderTime" type="time" value="10:00"></div>
      </div>
      <label class="reminder-repeat"><input id="reminderDaily" type="checkbox"> هر روز در همین ساعت یادآوری کن</label>
      <button class="btn" onclick="addReminder()">＋ ثبت یادآور</button>
      <button class="btn secondary" onclick="enableReminderNotifications()">فعال‌سازی اعلان دستگاه</button>
      <div id="reminderStatus" class="reminder-status">برای به‌صدا درآمدن یادآور، این برنامه و مرورگر باید باز بماند. اجازه اعلان دستگاه را نیز می‌توانید فعال کنید.</div>
    </div>
    <h3 style="font-size:16px;color:#8a5a0b;margin:20px 0 8px">یادآورهای ثبت‌شده</h3>
    <div id="remindersList"></div>
  </div>
</section>
<section id="shopping" class="page"><div class="card"><h2>خرید روزانه</h2><p class="muted">خرید را وارد کنید؛ مبلغ با سه‌رقمی جدا می‌شود و هزینه به حساب شما هم افزوده می‌شود.</p><div class="notebook-date" id="shoppingDate">روز هفته • تاریخ • ساعت</div><div class="field"><label for="shoppingTitle">چه چیزی خریدید؟</label><input id="shoppingTitle" placeholder="مثلاً نان و شیر"></div><div class="field"><label for="shoppingAmount">مبلغ خرید (تومان)</label><input id="shoppingAmount" class="money-input" type="text" inputmode="numeric" autocomplete="off" placeholder="مثلاً ۱۸۰٬۰۰۰" oninput="formatMoneyField(this)"></div><button class="btn green" onclick="addShopping(false)">ثبت خرید و ثبت هزینه</button><div class="invoice-total"><span>جمع خریدهای این صفحه</span><strong id="shoppingTotal">۰ تومان</strong></div><div class="invoice-head"><span>شرح خرید</span><span style="text-align:left">مبلغ (تومان)</span><span></span></div><div id="shoppingList"></div></div></section>
<section id="transactions" class="page"><div class="card"><h2>خلاصه حساب</h2><div class="settingsline"><span>مجموع درآمدها</span><b id="sumIn" class="in">۰ تومان</b></div><div class="settingsline"><span>مجموع هزینه‌ها</span><b id="sumOut" class="out">۰ تومان</b></div><div class="settingsline"><span>مانده فعلی</span><b id="sumNet">۰ تومان</b></div></div><div class="card"><h2>همه تراکنش‌ها</h2><div id="allList"></div><button class="btn secondary" onclick="exportData()">پشتیبان‌گیری از اطلاعات</button><button class="btn danger" onclick="clearTransactions()">پاک‌کردن همه تراکنش‌ها</button></div></section>
<section id="calendar" class="page"><div class="card"><h2>تقویم فارسی</h2><p class="muted">تقویم ماهانه ساده؛ تاریخ روز از تقویم فارسی دستگاه خوانده می‌شود.</p><div class="calendar-head"><button onclick="changeMonth(-1)">‹</button><b id="monthLabel">ماه جاری</b><button onclick="changeMonth(1)">›</button></div><div class="calendar-grid" id="calendarGrid"></div><button class="btn secondary" onclick="openPage('home')">بازگشت به جلد سررسید</button></div></section>
<section id="settings" class="page"><div class="card"><h2>تنظیمات سررسید و صدا</h2><div class="settingsline"><span>ذخیره اطلاعات</span><span class="pill">روی همین دستگاه</span></div><div class="settingsline"><span>نیاز به اینترنت برای دفتر</span><b>خیر</b></div><div class="field"><label for="clockType">نمایش ساعت روی جلد</label><select id="clockType" onchange="setClockType(this.value)"><option value="digital">ساعت دیجیتال</option><option value="analog">ساعت آنالوگ</option></select></div><div class="settingsline"><span>پاسخ‌گویی صوتی با مرام</span><label><input id="speechToggle" type="checkbox" checked onchange="setSpeechEnabled(this.checked)"> فعال باشد</label></div><button class="btn" onclick="testSpeech()">🔊 آزمایش صدای با مرام</button><p class="muted" id="speechSettingStatus">اگر صدا پخش نشد، صدای دستگاه و پشتیبانی صدای فارسی مرورگر را بررسی کنید.</p><button class="btn secondary" onclick="openPage('calendar')">📅 باز کردن تقویم فارسی</button><button class="btn secondary" onclick="exportData()">دریافت نسخه پشتیبان</button><div class="field"><label for="backupImportFile">بازیابی اطلاعات از نسخه پشتیبان</label><input id="backupImportFile" type="file" accept="application/json,.json"><button class="btn secondary" type="button" onclick="importData()">بازیابی نسخه پشتیبان</button><p class="muted">بازیابی، اطلاعات فعلی این برنامه را با اطلاعات فایل پشتیبان جایگزین می‌کند. قبل از ادامه، نسخه پشتیبان فعلی را نگه دارید.</p></div><div class="field"><label for="pin">رمز چهاررقمی (طرح اولیه)</label><input id="pin" type="password" inputmode="numeric" maxlength="4" placeholder="قفل واقعی هنوز فعال نیست"></div><p class="muted">داده‌ها در حافظه همین مرورگر نگهداری می‌شوند. برای پیشگیری از دست‌رفتن اطلاعات، مرتب نسخه پشتیبان بگیرید. شنیدن گفتار و تبدیل گفتار به متن به مرورگر و صدای نصب‌شده روی دستگاه وابسته است.</p></div></section>
</main>
<footer>نسخه آزمایشی • دفتر روزانه، خرید و دستیار سخنگو</footer>
<nav class="bottom"><button class="nav active" data-page="home" onclick="openPage('home')"><span>⌂</span>سررسید</button><button class="nav" data-page="notes" onclick="openPage('notes')"><span>✎</span>دفتر</button><button class="nav" data-page="shopping" onclick="openPage('shopping')"><span>🛒</span>خرید روزانه</button><button class="nav" data-page="transactions" onclick="openPage('transactions')"><span>▣</span>حساب</button><button class="nav" data-page="settings" onclick="openPage('settings')"><span>⚙</span>تنظیمات</button></nav>
<button id="floatingRecorder" class="floating-recorder" type="button" onclick="toggleFloatingRecording()" aria-label="ضبط صوت شناور" title="شروع یا پایان ضبط صوت">●</button><button id="floatingMic" class="floating-mic" type="button" onclick="floatingMicAction()" aria-label="ثبت صوتی در هر صفحه" title="ثبت با صدا؛ برای لغو بگویید پاک">🎙<small>بگویید: پاک</small></button><div id="voiceToast" class="voice-toast" role="status" aria-live="polite"></div>
</div>
<script>
'use strict';
const KEY='senior_accounting_v1', NOTEKEY='senior_notes_v1', FREEKEY='senior_free_note_v1', CLOCKKEY='senior_clock_type_v1', SHOPKEY='senior_shopping_v1', SPEECHKEY='senior_speech_enabled_v1', REMKEY='senior_reminders_v1';
const $=id=>document.getElementById(id);
const safeParse=(key,fallback)=>{try{const x=JSON.parse(localStorage.getItem(key)||'null');return x??fallback}catch(e){return fallback}};
let txs=safeParse(KEY,[]), notes=safeParse(NOTEKEY,[]), shoppingItems=safeParse(SHOPKEY,[]), reminders=safeParse(REMKEY,[]), monthOffset=0, voiceTarget='tx', toastTimer=null, pendingNoteVoice=false, pendingShoppingVoice=false, pendingVoiceTransaction=false, alarmAudioContext=null;
let speechEnabled=localStorage.getItem(SPEECHKEY)!=='false';let clockType=localStorage.getItem(CLOCKKEY)||'digital';
const fa=n=>Number(n||0).toLocaleString('fa-IR');
function money(n){return fa(n)+' تومان'}
function normalizeDigits(value){return String(value??'').replace(/[۰-۹]/g,d=>'۰۱۲۳۴۵۶۷۸۹'.indexOf(d)).replace(/[٠-٩]/g,d=>'٠١٢٣٤٥٦٧٨٩'.indexOf(d))}
function parseAmount(value){if(typeof value==='number')return Number.isFinite(value)?value:0;const digits=normalizeDigits(value).replace(/[^0-9]/g,'');return digits?Number(digits):0}
function formatMoneyField(input){if(!input)return;let raw=normalizeDigits(input.value).replace(/[^0-9]/g,'').replace(/^0+(?=\d)/,'');let formatted=raw.replace(/\B(?=(\d{3})+(?!\d))/g,'٬');input.value=formatted.replace(/[0-9]/g,d=>'۰۱۲۳۴۵۶۷۸۹'[Number(d)]);}
function attachMoneyFormatting(){['expenseAmount','incomeAmount','shoppingAmount'].forEach(id=>{const el=$(id);if(el)el.addEventListener('blur',()=>formatMoneyField(el))})}
function persistNotes(){localStorage.setItem(NOTEKEY,JSON.stringify(notes))}function persistShopping(){localStorage.setItem(SHOPKEY,JSON.stringify(shoppingItems))}
function saveTx(type,source='manual'){const title=$(type==='out'?'expenseTitle':'incomeTitle').value.trim(),amount=parseAmount($(type==='out'?'expenseAmount':'incomeAmount').value);if(!title||!amount||amount<=0){alert('عنوان و مبلغ معتبر را وارد کنید.');say('لطفاً عنوان و مبلغ را بررسی کنید.');return}if(pendingVoiceTransaction)source='voice';txs.unshift({id:Date.now(),type,title,amount,category:type==='out' ? $('expenseCategory').value : 'درآمد',note:$(type==='out'?'expenseNote':'incomeNote').value.trim(),source,date:jalaliDate()});pendingVoiceTransaction=false;localStorage.setItem(KEY,JSON.stringify(txs));render();[$(type==='out'?'expenseTitle':'incomeTitle'),$(type==='out'?'expenseAmount':'incomeAmount'),$(type==='out'?'expenseNote':'incomeNote')].forEach(x=>x.value='');openPage('home');say((type==='in'?'درآمد':'هزینه')+' ثبت شد. '+title+'، مبلغ '+money(amount));}
function openPage(id){document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id===id));document.querySelectorAll('.nav').forEach(b=>b.classList.toggle('active',b.dataset.page===id));if(id==='notes')renderNotes();if(id==='shopping')renderShopping();if(id==='calendar')renderCalendar();if(id==='settings'){if($('clockType'))$('clockType').value=clockType;if($('speechToggle'))$('speechToggle').checked=speechEnabled}window.scrollTo({top:0,behavior:'smooth'})}
function render(){const inc=txs.filter(t=>t.type==='in').reduce((s,t)=>s+Number(t.amount||0),0),out=txs.filter(t=>t.type==='out').reduce((s,t)=>s+Number(t.amount||0),0);$('balance').textContent=fa(inc-out);const markup=arr=>arr.length?arr.map(t=>`<div class="transaction"><div class="txicon">${t.type==='in'?'💰':(t.category==='خوراک و خرید'?'🛒':t.category==='دارو و درمان'?'💊':'🧾')}</div><div class="txtext"><b>${esc(t.title)}</b><small>${esc(t.category||'')} • ${esc(t.date||'')}</small></div><div class="money ${t.type}">${t.type==='in'?'+':'−'} ${fa(t.amount)}<small style="display:block;font-weight:normal">تومان</small></div></div>`).join(''):'<p class="muted">هنوز تراکنشی ثبت نشده است.</p>';if($('recentList'))$('recentList').innerHTML=markup(txs.slice(0,4));if($('allList'))$('allList').innerHTML=markup(txs);const incSum=$('sumIn'),outSum=$('sumOut'),net=$('sumNet');if(incSum)incSum.textContent=money(inc);if(outSum)outSum.textContent=money(out);if(net)net.textContent=money(inc-out)}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function jalaliDate(){try{return new Intl.DateTimeFormat('fa-IR-u-ca-persian',{year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date())}catch(e){return new Date().toLocaleDateString('fa-IR')}}
