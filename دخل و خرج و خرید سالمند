  // Remove the currency word immediately following the number expression.
  if(tokens[picked.end+1]&&currencyWords.has(tokens[picked.end+1]))keep.add(picked.end+1);
  const title=tokens.filter((t,i)=>!keep.has(i)&&!commandWords.has(t)&&!currencyWords.has(t)).join(' ').replace(/\s+/g,' ').trim();
  return{amount:picked.amount,title,sourceText:text};
}
function undoLastVoiceTransaction(){const idx=txs.findIndex(t=>t.source==='voice');if(idx<0)return false;const removed=txs.splice(idx,1)[0];localStorage.setItem(KEY,JSON.stringify(txs));if(removed.id){shoppingItems=shoppingItems.filter(s=>s.txId!==removed.id);persistShopping()}render();renderShopping();say('ثبت صوتی قبلی حذف شد: '+(removed.title||'تراکنش')+'، '+money(removed.amount),true);return true}
function undoLastVoiceNote(){const last=notes.findIndex(n=>n.source==='voice');if(last>=0){const n=notes.splice(last,1)[0];persistNotes();renderNotes();say('مورد صوتی از دفتر پاک شد: '+n.text,true);return true}return false}
function undoLastVoiceShopping(){const last=shoppingItems.findIndex(n=>n.source==='voice');if(last>=0){deleteShopping(last,true);say('آخرین خرید صوتی پاک شد.',true);return true}return false}
function showStatusOnly(text){if($('voiceStatus'))$('voiceStatus').textContent=text;const toast=$('voiceToast');if(toast){toast.textContent=text;toast.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>toast.classList.remove('show'),3500)}}
function listenVoice(){
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(!SR){say('این مرورگر تبدیل گفتار به متن را پشتیبانی نمی‌کند. Chrome یا Edge را امتحان کنید. صدای پاسخ‌گوی با مرام از تنظیمات جداگانه قابل آزمایش است.',true);return}
  if('speechSynthesis' in window)window.speechSynthesis.cancel();
  const r=new SR();r.lang='fa-IR';r.interimResults=false;r.maxAlternatives=1;showStatusOnly('گوش می‌دهم. برای لغو متن واردشده بگویید «پاک». برای مبلغ، عدد نمایش‌داده‌شده را بررسی کنید.');
  try{r.start()}catch(e){say('میکروفون در حال استفاده است؛ چند لحظه دیگر دوباره بزنید.',true);return}
  r.onresult=e=>{
    const s=normalizeSpeech(e.results[0][0].transcript||'');
    if(isClearCommand(s)){
      if(voiceTarget==='note'){
        if($('newNote').value){$('newNote').value='';pendingNoteVoice=false;say('متن واردشده پاک شد. یادداشت قبلی حذف نشد.',true)}
        else if(!undoLastVoiceNote())say('متن صوتی برای پاک کردن وجود ندارد.',true);
      }else if(voiceTarget==='shopping'){
        if($('shoppingTitle').value||$('shoppingAmount').value){$('shoppingTitle').value='';$('shoppingAmount').value='';pendingShoppingVoice=false;say('نام و مبلغ خرید پاک شد. هیچ تراکنشی تغییر نکرد.',true)}
        else if(!undoLastVoiceShopping())say('خرید صوتی برای پاک کردن پیدا نشد.',true);
      }else{
        const isIncome=$('addIncome').classList.contains('active');const titleEl=$(isIncome?'incomeTitle':'expenseTitle'),amountEl=$(isIncome?'incomeAmount':'expenseAmount');
        if(titleEl.value||amountEl.value){titleEl.value='';amountEl.value='';$(isIncome?'incomeNote':'expenseNote').value='';pendingVoiceTransaction=false;say('عنوان و مبلغ روی فرم پاک شد. هیچ حساب ثبت‌شده‌ای تغییر نکرد.',true)}
        else if(!undoLastVoiceTransaction())say('ثبت صوتی قبلی برای پاک کردن پیدا نشد.',true);
      }
      return;
    }
    // In the diary, keep the entire utterance as text; quantities such as 1.5 kg are not money.
    if(voiceTarget==='note'){$('newNote').value=s;pendingNoteVoice=true;say('متن شنیده شد: '+s+'. برای ذخیره، دکمه افزودن را بزنید.',true);return}
    const parsed=extractVoiceAmountAndTitle(s);
    if(voiceTarget==='shopping'){
      $('shoppingTitle').value=parsed.title||s;
      if(parsed.amount>0){$('shoppingAmount').value=String(parsed.amount);formatMoneyField($('shoppingAmount'))}
      pendingShoppingVoice=true;
      say(parsed.amount>0?'مبلغی که شنیدم '+money(parsed.amount)+' است. نام و مبلغ را بررسی کنید؛ سپس دکمه ثبت خرید را بزنید. هنوز چیزی ثبت نشده است.':'نام خرید شنیده شد، اما مبلغ را مطمئن تشخیص ندادم. مبلغ را دستی وارد کنید؛ هنوز چیزی ثبت نشده است.',true);return;
    }
    const type=/درآمد|حقوق|دریافت|واریز/.test(s)?'in':'out';
    openPage(type==='in'?'addIncome':'addExpense');
    const titleEl=$(type==='in'?'incomeTitle':'expenseTitle'),amountEl=$(type==='in'?'incomeAmount':'expenseAmount');
    titleEl.value=parsed.title||s;
    if(parsed.amount>0){amountEl.value=String(parsed.amount);formatMoneyField(amountEl);pendingVoiceTransaction=true;say('مبلغی که شنیدم '+money(parsed.amount)+' است. لطفاً عنوان و مبلغ روی صفحه را بررسی کنید و فقط اگر درست بود دکمه ثبت را بزنید. هنوز چیزی به حساب اضافه نشده است.',true)}
    else{amountEl.value='';pendingVoiceTransaction=false;say('عنوان شنیده شد، اما مبلغ را با اطمینان تشخیص ندادم. مبلغ را دستی وارد کنید؛ هیچ تراکنشی ثبت نشده است.',true)}
  };
  r.onerror=e=>{const msg=e.error==='not-allowed'?'اجازه میکروفون داده نشده است. مجوز میکروفون مرورگر را فعال کنید.':'صدای شما دریافت نشد. دوباره امتحان کنید.';say(msg,true)};
}

// Voice recordings are stored as audio blobs in IndexedDB, not as speech-to-text.
const REC_DB='senior_accounting_recordings_v1', REC_STORE='recordings';
let recorderDB=null, mediaRecorder=null, activeAudioChunks=[], activeAudioStream=null, recordingStartedAt=0;
function openRecorderDB(){
  return new Promise((resolve,reject)=>{
    if(!('indexedDB' in window)){reject(new Error('ذخیره‌سازی محلی پشتیبانی نمی‌شود.'));return}
    const req=indexedDB.open(REC_DB,1);
    req.onupgradeneeded=()=>{const db=req.result;if(!db.objectStoreNames.contains(REC_STORE)){const st=db.createObjectStore(REC_STORE,{keyPath:'id',autoIncrement:true});st.createIndex('createdAt','createdAt')}}
    req.onsuccess=()=>{recorderDB=req.result;resolve(recorderDB)};
    req.onerror=()=>reject(req.error||new Error('باز کردن دفتر ضبط ناموفق بود.'));
  });
}
async function recorderStore(mode,action,value){
  const db=recorderDB||await openRecorderDB();
  return new Promise((resolve,reject)=>{
    const tx=db.transaction(REC_STORE,mode), store=tx.objectStore(REC_STORE);
    let req;
    if(action==='all')req=store.getAll();
    else if(action==='add')req=store.add(value);
    else if(action==='delete')req=store.delete(value);
    if(req){req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error)}
    else resolve();
    tx.onerror=()=>reject(tx.error);
  });
}
function recorderStatus(message){const el=$('recordingStatus');if(el)el.textContent=message}
async function startAudioRecording(){
  if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia||!window.MediaRecorder){
    recorderStatus('این مرورگر ضبط صدا را پشتیبانی نمی‌کند. Chrome یا Edge به‌روز را امتحان کنید.');return;
  }
  try{
    await openRecorderDB();
    activeAudioStream=await navigator.mediaDevices.getUserMedia({audio:true});
    const mime=['audio/webm;codecs=opus','audio/webm','audio/mp4'].find(t=>MediaRecorder.isTypeSupported(t));
    mediaRecorder=mime?new MediaRecorder(activeAudioStream,{mimeType:mime}):new MediaRecorder(activeAudioStream);
    activeAudioChunks=[];recordingStartedAt=Date.now();
    mediaRecorder.ondataavailable=e=>{if(e.data&&e.data.size)activeAudioChunks.push(e.data)};
    mediaRecorder.onerror=()=>recorderStatus('هنگام ضبط خطا رخ داد. مجوز میکروفون و دستگاه ورودی را بررسی کنید.');
    mediaRecorder.onstop=async()=>{
      try{
        const blob=new Blob(activeAudioChunks,{type:mediaRecorder.mimeType||'audio/webm'});
        if(blob.size){
          const item={blob,category:$('recordCategory')?.value||'یادداشت روزانه',createdAt:Date.now(),duration:Math.max(1,Math.round((Date.now()-recordingStartedAt)/1000)),type:blob.type||'audio/webm'};
          await recorderStore('readwrite','add',item);
          recorderStatus('ضبط ذخیره شد. می‌توانید آن را پخش یا به‌صورت فایل دانلود کنید.');
          await renderRecordings();
        }else recorderStatus('صدایی ضبط نشد؛ دوباره امتحان کنید.');
      }catch(err){recorderStatus('ذخیره ضبط ناموفق بود. فایل را با مرورگر یا دستگاه دیگری امتحان کنید.')}
      if(activeAudioStream)activeAudioStream.getTracks().forEach(t=>t.stop());
      activeAudioStream=null;activeAudioChunks=[];
      $('recordStart').disabled=false;$('recordStop').disabled=true;
      const floating=$('floatingRecorder');if(floating){floating.classList.remove('recording');floating.textContent='●';floating.title='شروع ضبط صوت شناور'}
    };
    mediaRecorder.start(1000);
    $('recordStart').disabled=true;$('recordStop').disabled=false;
    const floating=$('floatingRecorder');if(floating){floating.classList.add('recording');floating.textContent='■';floating.title='پایان ضبط و ذخیره فایل صوتی'}
    recorderStatus('در حال ضبط… صحبت کنید؛ سپس «پایان و ذخیره» را بزنید.');
  }catch(err){
    if(activeAudioStream)activeAudioStream.getTracks().forEach(t=>t.stop());
    activeAudioStream=null;
    const floating=$('floatingRecorder');if(floating){floating.classList.remove('recording');floating.textContent='●'}
    recorderStatus(err&&err.name==='NotAllowedError'?'اجازه میکروفون داده نشد. مجوز Microphone را برای Chrome فعال کنید.':'ضبط شروع نشد. مطمئن شوید میکروفون وصل است و صفحه در Chrome یا Edge باز شده است.');
  }
}
function stopAudioRecording(){
  if(mediaRecorder&&mediaRecorder.state!=='inactive'){mediaRecorder.stop();recorderStatus('در حال ذخیره فایل صوتی…')}
}
function toggleFloatingRecording(){
  if(mediaRecorder&&mediaRecorder.state!=='inactive'){stopAudioRecording();return}
  startAudioRecording();
}
function formatRecordingDate(ts){
  try{return new Intl.DateTimeFormat('fa-IR',{dateStyle:'short',timeStyle:'short'}).format(new Date(ts))}catch(e){return new Date(ts).toLocaleString()}
}
function formatDuration(sec){const m=Math.floor(sec/60),r=sec%60;return (m?m+' دقیقه ':'')+r+' ثانیه'}
async function renderRecordings(){
  const root=$('recordingsList');if(!root)return;
  try{
    const items=await recorderStore('readonly','all');
    items.sort((a,b)=>b.createdAt-a.createdAt);
    if(!items.length){root.innerHTML='<p class="muted">هنوز فایل صوتی ضبط نشده است.</p>';return}
    root.innerHTML='';
    items.forEach(item=>{
      const wrap=document.createElement('div');wrap.className='recording-item';
      const title=document.createElement('strong');title.textContent='ضبط صوتی — '+item.category;wrap.appendChild(title);
      const meta=document.createElement('small');meta.textContent=formatRecordingDate(item.createdAt)+' • '+formatDuration(item.duration);wrap.appendChild(meta);
      const audio=document.createElement('audio');audio.controls=true;audio.preload='none';audio.src=URL.createObjectURL(item.blob);wrap.appendChild(audio);
      const actions=document.createElement('div');actions.className='recording-actions';
      const download=document.createElement('button');download.className='recording-download';download.textContent='دانلود فایل';download.onclick=()=>{const url=URL.createObjectURL(item.blob),a=document.createElement('a');a.href=url;a.download='record-'+item.id+'.'+(item.type&&item.type.includes('mp4')?'mp4':'webm');document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1500)};actions.appendChild(download);
      const del=document.createElement('button');del.className='recording-delete';del.textContent='حذف ضبط';del.onclick=async()=>{if(confirm('این فایل ضبط‌شده حذف شود؟')){await recorderStore('readwrite','delete',item.id);renderRecordings()}};actions.appendChild(del);
      wrap.appendChild(actions);root.appendChild(wrap);
    });
  }catch(e){root.textContent='فهرست ضبط‌ها باز نشد. از Chrome یا Edge به‌روز استفاده کنید.'}
}

function getJalaliParts(){try{const parts=new Intl.DateTimeFormat('en-u-ca-persian',{year:'numeric',month:'numeric',day:'numeric'}).formatToParts(new Date());const p={};parts.forEach(x=>p[x.type]=x.value);return{year:Number(p.year),month:Number(p.month),day:Number(p.day)}}catch(e){return{year:1405,month:7,day:1}}}
const monthNames=['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];
function renderCalendar(){const current=getJalaliParts();let year=current.year,month=current.month+monthOffset;while(month>12){month-=12;year++}while(month<1){month+=12;year--}$('monthLabel').textContent=monthNames[month-1]+' '+fa(year);const days=month<=6?31:month<=11?30:30;const first=(month*3+1)%7;let out=['ش','ی','د','س','چ','پ','ج'].map(x=>`<div class="dayname">${x}</div>`).join('');for(let i=0;i<first;i++)out+='<div class="day empty"></div>';for(let d=1;d<=days;d++)out+=`<div class="day ${d===current.day&&month===current.month&&year===current.year?'today':''}">${fa(d)}</div>`;$('calendarGrid').innerHTML=out}
function changeMonth(n){monthOffset+=n;renderCalendar()}
// Keep date, clock, settings and summaries fresh when opened.
if($('clockType'))$('clockType').value=clockType;if($('speechToggle'))$('speechToggle').checked=speechEnabled;setClockType(clockType);attachMoneyFormatting();render();renderNotes();renderShopping();renderCalendar();initReminderForm();renderRecordings();updateDateTime();updateClock();checkReminders();setInterval(()=>{updateDateTime();updateClock();checkReminders()},10000);

// PWA: cache the app shell when served over HTTPS or localhost.
if ('serviceWorker' in navigator && (location.protocol === 'https:' || location.hostname === 'localhost' || location.hostname === '127.0.0.1')) {
  window.addEventListener('load', () => navigator.serviceWorker.register('./sw.js').catch(() => {}));
}
